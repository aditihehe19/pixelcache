# Copy to backend/.env and adjust. All values are optional.

# Where the C++ build lives (contains cachevision_bench_native and cachevision_sim)
# PIXELCACHE_BUILD_DIR=../build

# Backend state: SQLite database, temporary job directories, generated reports
# PIXELCACHE_DATA_DIR=./data
# PIXELCACHE_DATABASE_URL=sqlite:///./data/pixelcache.db
# PostgreSQL works too (needs `pip install psycopg[binary]`):
# PIXELCACHE_DATABASE_URL=postgresql+psycopg://user:password@localhost/pixelcache

# Comma-separated origins allowed by CORS (the Vite dev server by default)
PIXELCACHE_FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Limits
PIXELCACHE_MAX_PIXELS=67108864
PIXELCACHE_MAX_SIM_PIXELS=16777216
PIXELCACHE_MAX_VALIDATION_PIXELS=1048576
PIXELCACHE_MAX_UPLOAD_MB=25
PIXELCACHE_MAX_QUEUED_JOBS=8

# Timeouts (seconds)
PIXELCACHE_EXPERIMENT_TIMEOUT_S=900
PIXELCACHE_SUITE_TIMEOUT_S=7200
PIXELCACHE_SIM_TIMEOUT_S=600
PIXELCACHE_VALIDATION_TIMEOUT_S=300

# Keep raw engine output directories after parsing (debugging only)
# PIXELCACHE_KEEP_JOB_DIRS=1
